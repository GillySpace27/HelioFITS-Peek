# Build output
build/
DerivedData/
*.xcarchive
# macOS
.DS_Store
# Xcode user state
xcuserdata/
*.xcuserstate
# Importer build artifacts
FITSMetadataImporter/build/
# Ship output
ship.log
# stray object files (fitsshim.c is vendored; .a provides it)
*.o
__.SYMDEF*
.venv/

# App Store Connect API keys must never live in the repo
*.p8

__pycache__/

# Kept build outputs: zipped by ship.sh and lsclean.sh, never pruned by a script
# (scripts/attic-report.sh lists them)
build-attic/
# App Store screenshots, one folder per version (make-screenshots.sh)
screenshots/
# Git worktrees, e.g. .claude/worktrees/rollback-<tag> from scripts/rollback.sh
.claude/worktrees/

# HelioFITSCore package build output
HelioFITSCore/.build/
HelioFITSCore/.swiftpm/

# Fuzz build output: CFITSIO build, harness binaries, corpora, crash files (HF-11)
Fuzz/out/
# The user manual build (DOCS-3)
manual/_build/
