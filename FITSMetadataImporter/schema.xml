<?xml version="1.0" encoding="UTF-8"?>
<schema version="1.0" xmlns="http://www.apple.com/metadata"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://www.apple.com/metadata file:///System/Library/Frameworks/CoreServices.framework/Frameworks/Metadata.framework/Resources/MetadataSchema.xsd">
    <note>
        Custom Spotlight attributes extracted from FITS image headers
        (SDO/AIA and similar solar-physics data products).
    </note>
    <attributes>
        <attribute name="com_gillyspace27_fits_wavelnth" type="CFNumber"/>
        <attribute name="com_gillyspace27_fits_instrume" type="CFString"/>
        <attribute name="com_gillyspace27_fits_telescop" type="CFString"/>
        <attribute name="com_gillyspace27_fits_dateobs"  type="CFDate"/>
        <attribute name="com_gillyspace27_fits_exptime"  type="CFNumber"/>
        <attribute name="com_gillyspace27_fits_nhdus"    type="CFNumber"/>
        <attribute name="com_gillyspace27_fits_resolution" type="CFString"/>
        <attribute name="com_gillyspace27_hfrec_producer" type="CFString"/>
        <attribute name="com_gillyspace27_hfrec_output" type="CFString"/>
        <attribute name="com_gillyspace27_hfrec_labels" type="CFString" multivalued="true"/>
        <attribute name="com_gillyspace27_hfrec_instruments" type="CFString" multivalued="true"/>
        <attribute name="com_gillyspace27_hfrec_layers" type="CFNumber"/>
        <attribute name="com_gillyspace27_hfrec_start" type="CFDate"/>
        <attribute name="com_gillyspace27_hfrec_end" type="CFDate"/>
    </attributes>

    <types>
        <type name="gov.nasa.gsfc.fits">
            <note>
                FITS image files (.fits/.fts/.fit).
            </note>
            <allattrs>
                com_gillyspace27_fits_telescop
                com_gillyspace27_fits_instrume
                com_gillyspace27_fits_wavelnth
                com_gillyspace27_fits_resolution
                com_gillyspace27_fits_dateobs
                com_gillyspace27_fits_exptime
                com_gillyspace27_fits_nhdus
            </allattrs>
            <displayattrs>
                com_gillyspace27_fits_telescop
                com_gillyspace27_fits_instrume
                com_gillyspace27_fits_wavelnth
                com_gillyspace27_fits_resolution
                com_gillyspace27_fits_dateobs
                com_gillyspace27_fits_exptime
                com_gillyspace27_fits_nhdus
            </displayattrs>
        </type>
        <type name="com.gillyspace27.hfrecord">
            <note>
                Processing records (.hfrec.json sidecars) that HelioFITS Studio and pyHelioFITS
                write beside an export.
            </note>
            <allattrs>
                com_gillyspace27_hfrec_producer
                com_gillyspace27_hfrec_output
                com_gillyspace27_hfrec_labels
                com_gillyspace27_hfrec_instruments
                com_gillyspace27_hfrec_layers
                com_gillyspace27_hfrec_start
                com_gillyspace27_hfrec_end
            </allattrs>
            <displayattrs>
                com_gillyspace27_hfrec_output
                com_gillyspace27_hfrec_instruments
                com_gillyspace27_hfrec_start
                com_gillyspace27_hfrec_end
                com_gillyspace27_hfrec_producer
            </displayattrs>
        </type>
    </types>
</schema>
